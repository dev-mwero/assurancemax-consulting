# Site
NEXT_PUBLIC_SITE_URL=https://assurancemax.co.ke

# SMTP (nodemailer) - assurancemax.co.ke mail server (Exim, rcnoc.com / Hostinger).
# Ports 25 and 2500 are not offered. Use 587 (STARTTLS) or 465 (implicit TLS).
SMTP_HOST=mail.assurancemax.co.ke
SMTP_PORT=587
SMTP_SECURE=false
# The SMTP login is the full mailbox address. Note the @ sign: omitting it fails
# with "535 Incorrect authentication data". This is the mailbox password, not a
# relay password, so use a dedicated account rather than a personal one.
SMTP_USER=info@assurancemax.co.ke
SMTP_PASS=
# The From address. Must be a real mailbox on this domain or mail will be refused.
# Kept separate from SMTP_USER so replies and reputation stay isolated from the
# inbox that receives the form notifications.
SMTP_FROM=no-reply@assurancemax.co.ke

# Email behaviour
# Send a confirmation email to the person who submitted the form. Off by default.
SEND_ACKNOWLEDGEMENT=false
# Per-IP submission throttle, applied to each form separately. In-memory, so it
# resets on deploy and is per-instance. Not a substitute for a CAPTCHA.
FORM_RATE_LIMIT_WINDOW_MS=3600000
FORM_RATE_LIMIT_MAX=5

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/assurancemax